{
  "name": "market-play-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "export:check": "expo export --platform all",
    "test": "node --experimental-strip-types --test src/features/cart/cart.test.ts src/features/budget/budget.test.ts src/features/payment/payment.test.ts src/features/payment/change-quiz.test.ts src/features/payment/receipt.test.ts src/features/catalog/catalog.test.ts src/features/catalog/real-price-preview.test.ts",
    "start:price-preview": "node ../../scripts/device/start-price-preview.mjs",
    "verify:device": "node ../../scripts/device/verify.mjs",
    "verify:device:check": "node ../../scripts/device/verify.mjs --no-commit",
    "device:doctor": "node ../../scripts/device/verify.mjs --doctor",
    "verify:receipt": "node ../../scripts/device/verify.mjs --receipt-only"
  },
  "private": true
}
