          "backgroundColor": "#FAF8EF",
          "image": "./assets/brand/market-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f216e8cc-25c4-4c1b-9a6a-8e5826bb4f1f"
      }
