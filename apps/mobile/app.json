    "slug": "store-price",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/market-icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8EF",
        "foregroundImage": "./assets/brand/market-foreground.png",
        "monochromeImage": "./assets/brand/market-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ungjo.storeprice",
      "versionCode": 2,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
